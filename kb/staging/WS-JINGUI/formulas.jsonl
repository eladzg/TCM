{"name_zh": "栝蔞桂枝湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.11", "ingredients": [{"name": "栝蔞根", "dose_original": "二兩", "prep": ""}, {"name": "桂枝", "dose_original": "三兩", "prep": ""}, {"name": "芍藥", "dose_original": "三兩", "prep": ""}, {"name": "甘草", "dose_original": "二兩", "prep": ""}, {"name": "生薑", "dose_original": "三兩", "prep": ""}, {"name": "大棗", "dose_original": "十二枚", "prep": ""}], "preparation": "上六味，以水九升，煮取三升，分溫三服，取微汗。汗不出，食頃，啜熱粥發之。", "ingredient_text": "栝蔞根二兩桂枝三兩芍藥三兩甘草二兩生薑三兩大棗十二枚", "clauses": ["2.11"]}
{"name_zh": "葛根湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.12", "ingredients": [{"name": "葛根", "dose_original": "四兩", "prep": ""}, {"name": "麻黃", "dose_original": "三兩", "prep": "去節"}, {"name": "桂枝", "dose_original": "二兩", "prep": "去皮"}, {"name": "芍藥", "dose_original": "二兩", "prep": ""}, {"name": "甘草", "dose_original": "二兩", "prep": "炙"}, {"name": "生薑", "dose_original": "三兩", "prep": "切"}, {"name": "大棗", "dose_original": "十二枚", "prep": "擘"}], "preparation": "上七味，㕮咀，以水一斗，先煮麻黃、葛根，減二升，去沫，內諸藥，煮取三升，去滓，溫服一升，覆取微似汗，不須啜粥，餘如桂枝湯法將息及禁忌。", "ingredient_text": "葛根四兩麻黃三兩（去節）桂枝二兩（去皮）芍藥二兩甘草二兩（炙）生薑三兩（切）大棗十二枚（擘）", "clauses": ["2.12"]}
{"name_zh": "大承氣湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.13", "ingredients": [{"name": "大黃", "dose_original": "四兩", "prep": "酒洗"}, {"name": "厚朴", "dose_original": "半斤", "prep": "炙去皮"}, {"name": "枳實", "dose_original": "五枚", "prep": ""}, {"name": "芒硝", "dose_original": "三合", "prep": ""}], "preparation": "上四味，以水一斗，先煮枳朴，取五升，去滓，內大黃，煮取二升，去滓，內芒硝，更上微火一二沸，分溫再服，得下止服。", "ingredient_text": "大黃四兩（酒洗）厚朴半斤（炙去皮）枳實五枚芒硝三合", "clauses": ["2.13", "11.13", "11.22", "11.23", "11.24", "17.39", "17.40", "17.41", "17.42", "21.3", "21.7"]}
{"name_zh": "麻黃加朮湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.20", "ingredients": [{"name": "麻黃", "dose_original": "三兩", "prep": "去節"}, {"name": "桂枝", "dose_original": "二兩", "prep": "去皮"}, {"name": "甘草", "dose_original": "二兩", "prep": "炙"}, {"name": "杏仁", "dose_original": "七十個", "prep": "去皮尖"}, {"name": "白朮", "dose_original": "四兩", "prep": ""}], "preparation": "上五味，以水九升，先煮麻黃，減二升，去上沫，內諸藥，煮取二升半，去滓，溫服八合，覆取微似汗。", "ingredient_text": "麻黃三兩（去節）桂枝二兩（去皮）甘草二兩（炙）杏仁七十個（去皮尖）白朮四兩", "clauses": ["2.20"]}
{"name_zh": "麻黃杏仁薏苡甘草湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.21", "ingredients": [{"name": "麻黃", "dose_original": "半兩", "prep": "去節"}, {"name": "甘草", "dose_original": "一兩", "prep": "炙"}, {"name": "薏苡仁", "dose_original": "半兩", "prep": ""}, {"name": "杏仁", "dose_original": "十個", "prep": "去皮尖，炒"}], "preparation": "上銼麻豆大，每服四錢匕，水盞半，煮八分，去滓，溫服，有微汗，避風。", "ingredient_text": "麻黃（去節）半兩（湯泡）甘草一兩（炙）薏苡仁半兩杏仁十個（去皮尖，炒）", "clauses": ["2.21"]}
{"name_zh": "防己黃耆湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.22", "ingredients": [{"name": "防己", "dose_original": "一兩", "prep": ""}, {"name": "甘草", "dose_original": "半兩", "prep": "炒"}, {"name": "白朮", "dose_original": "七錢半", "prep": ""}, {"name": "黃耆", "dose_original": "一兩一分", "prep": "去蘆"}], "preparation": "上銼麻豆大，每抄五錢匕，生薑四片，大棗一枚，水盞半，煎八分，去滓，溫服，良久再服。喘者加麻黃半兩，胃中不和者加芍藥三分，氣上衝者加桂枝三分，下有陳寒者加細辛三分。服後當如蟲行皮中，從腰下如冰，後坐被上，又以一被繞腰以下，溫令微汗，差。", "ingredient_text": "防己一兩，甘草半兩（炒），白朮七錢半，黃耆一兩一分（去蘆）", "clauses": ["2.22", "14.27"]}
{"name_zh": "桂枝附子湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.23", "ingredients": [{"name": "桂枝", "dose_original": "四兩", "prep": "去皮"}, {"name": "生薑", "dose_original": "三兩", "prep": "切"}, {"name": "附子", "dose_original": "三枚", "prep": "炮去皮，破八片"}, {"name": "甘草", "dose_original": "二兩", "prep": "炙"}, {"name": "大棗", "dose_original": "十二枚", "prep": "擘"}], "preparation": "上五味，以水六升，煮取二升，去滓，分溫三服。", "ingredient_text": "桂枝四兩（去皮）生薑三兩（切）附子三枚（炮去皮，破八片）甘草二兩（炙）大棗十二枚（擘）", "clauses": ["2.23"]}
{"name_zh": "白朮附子湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.23", "ingredients": [{"name": "白朮", "dose_original": "二兩", "prep": ""}, {"name": "附子", "dose_original": "一枚半", "prep": "炮，去皮"}, {"name": "甘草", "dose_original": "一兩", "prep": "炙"}, {"name": "生薑", "dose_original": "一兩半", "prep": "切"}, {"name": "大棗", "dose_original": "六枚", "prep": "擘"}], "preparation": "上五味，以水三升，煮取一升，去滓，分溫三服。一服覺身痹，半日許，再服，三服都盡，其人如冒狀，勿怪，即是朮附並走皮中，逐水氣未得除故耳。", "ingredient_text": "白朮二兩附子一枚半（炮，去皮）甘草一兩（炙）生薑一兩半（切）大棗六枚（擘）", "clauses": []}
{"name_zh": "甘草附子湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.24", "ingredients": [{"name": "甘草", "dose_original": "二兩", "prep": "炙"}, {"name": "白朮", "dose_original": "二兩", "prep": ""}, {"name": "附子", "dose_original": "二枚", "prep": "炮去皮"}, {"name": "桂枝", "dose_original": "四兩", "prep": "去皮"}], "preparation": "上四味，以水六升，煮取三升，去滓。溫服一升，日三服，初服得微汗則解，能食，汗出復煩者，服五合。恐一升多者，服六、七合為妙。", "ingredient_text": "甘草二兩（炙）白朮二兩附子二枚（炮去皮）桂枝四兩（去皮）", "clauses": ["2.24"]}
{"name_zh": "白虎加人參湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.26", "ingredients": [{"name": "知母", "dose_original": "六兩", "prep": ""}, {"name": "石膏", "dose_original": "一斤", "prep": "碎"}, {"name": "甘草", "dose_original": "二兩", "prep": ""}, {"name": "粳米", "dose_original": "六合", "prep": ""}, {"name": "人參", "dose_original": "三兩", "prep": ""}], "preparation": "上五味，以水一斗，煮米熟，湯成，去滓，溫服一升，日三服。", "ingredient_text": "知母六兩石膏一斤（碎）甘草二兩粳米六合人參三兩", "clauses": ["2.26", "13.13"]}
{"name_zh": "一物瓜蒂湯", "herbal": true, "chapter": "痙濕暍病脈證並治第二", "after_clause": "2.27", "ingredients": [{"name": "瓜蒂", "dose_original": "二十個", "prep": ""}], "preparation": "上銼，以水一升，煮取五合，去滓，頓服。", "ingredient_text": "瓜蒂二十個", "clauses": ["2.27"]}
{"name_zh": "百合知母湯", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.2", "ingredients": [{"name": "知母", "dose_original": "三兩", "prep": "切"}], "preparation": "上先以水洗百合，漬一宿，當白沫出，去其水，更以泉水二升，煎取一升，去滓；別以泉水二升煎知母，取一升，去滓；後合和，煎取一升五合，分溫再服。", "ingredient_text": "百合七枚（擘）知母三兩（切）", "clauses": ["3.2"]}
{"name_zh": "滑石代赭湯", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.3", "ingredients": [{"name": "滑石", "dose_original": "三兩", "prep": "碎，綿裹"}, {"name": "代赭石", "dose_original": "如彈丸大一枚", "prep": "碎，綿裹"}], "preparation": "上先以水洗百合，漬一宿，當白沫出，去其水，更以泉水二升，煎取一升，去滓；別以泉水二升煎滑石、代赭，取一升，去滓；後合和重煎，取一升五合，分溫服。", "ingredient_text": "百合七枚（擘）滑石三兩（碎，綿裹）代赭石如彈丸大一枚（碎，綿裹）", "clauses": ["3.3"]}
{"name_zh": "百合雞子湯", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.4", "ingredients": [{"name": "雞子黃", "dose_original": "一枚", "prep": ""}], "preparation": "上先以水洗百合，漬一宿，當白沫出，去其水，更以泉水二升，煎取一升，去滓，內雞子黃，攪勻，煎五分，溫服。", "ingredient_text": "百合七枚（擘）雞子黃一枚", "clauses": []}
{"name_zh": "百合地黃湯", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.5", "ingredients": [{"name": "生地黃汁", "dose_original": "一升", "prep": ""}], "preparation": "上以水洗百合，漬一宿，當白沫出，去其水，更以泉水二升，煎取一升，去滓，內地黃汁，煎取一升五合，分溫再服。中病，勿更服。大便當如漆。", "ingredient_text": "百合七枚（擘）生地黃汁一升", "clauses": ["3.5"]}
{"name_zh": "栝蔞牡蠣散", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.7", "ingredients": [{"name": "栝蔞根", "dose_original": null, "prep": ""}, {"name": "牡蠣熬", "dose_original": "等分", "prep": ""}], "preparation": "上為細末，飲服方寸匕，日三服。", "ingredient_text": "栝蔞根牡蠣熬等分", "clauses": []}
{"name_zh": "百合滑石散", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.8", "ingredients": [{"name": "滑石", "dose_original": "三兩", "prep": ""}], "preparation": "上為散，飲服方寸匕，日三服。當微利者，止服，熱則除。", "ingredient_text": "百合一兩（炙）滑石三兩", "clauses": ["3.8"]}
{"name_zh": "甘草瀉心湯", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.10", "ingredients": [{"name": "甘草", "dose_original": "四兩", "prep": ""}, {"name": "黃芩", "dose_original": "三兩", "prep": ""}, {"name": "人參", "dose_original": "三兩", "prep": ""}, {"name": "乾薑", "dose_original": "三兩", "prep": ""}, {"name": "黃連", "dose_original": "一兩", "prep": ""}, {"name": "大棗", "dose_original": "十二枚", "prep": ""}, {"name": "半夏", "dose_original": "半升", "prep": ""}], "preparation": "上七味，水一斗，煮取六升，去滓再煎，取三升，溫服一升，日三服。", "ingredient_text": "甘草四兩黃芩三兩人參三兩乾薑三兩黃連一兩大棗十二枚半夏半升", "clauses": ["3.10"]}
{"name_zh": "赤豆當歸散", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.13", "ingredients": [{"name": "赤小豆", "dose_original": "三升", "prep": "浸，令芽出，曝乾"}, {"name": "當歸", "dose_original": null, "prep": ""}], "preparation": "上二味，杵為散，漿水服方寸匕，日三服。", "ingredient_text": "赤小豆三升（浸，令芽出，曝乾）當歸", "clauses": ["3.13"]}
{"name_zh": "升麻鱉甲湯", "herbal": true, "chapter": "百合病狐惑陰陽毒病脈證並治第三", "after_clause": "3.15", "ingredients": [{"name": "升麻", "dose_original": "二兩", "prep": ""}, {"name": "當歸", "dose_original": "一兩", "prep": ""}, {"name": "蜀椒", "dose_original": "一兩", "prep": "炒去汗"}, {"name": "甘草", "dose_original": "二兩", "prep": ""}, {"name": "雄黃", "dose_original": "半兩", "prep": "研"}, {"name": "鱉甲手指大", "dose_original": "一片", "prep": "炙"}], "preparation": "上六味，以水四升，煮取一升，頓服之，老小再服，取汗。", "ingredient_text": "升麻二兩當歸一兩蜀椒（炒去汗）一兩甘草二兩雄黃半兩（研）鱉甲手指大一片（炙）", "clauses": ["3.14"]}
{"name_zh": "白虎加桂枝湯", "herbal": true, "chapter": "瘧病脈證並治第四", "after_clause": "4.4", "ingredients": [{"name": "知母", "dose_original": "六兩", "prep": ""}, {"name": "甘草", "dose_original": "二兩", "prep": "炙"}, {"name": "石膏", "dose_original": "一斤", "prep": ""}, {"name": "粳米", "dose_original": "二合", "prep": ""}, {"name": "桂枝", "dose_original": "三兩", "prep": "去皮"}], "preparation": "上銼，每五錢，水一盞半，煎至八分，去滓，溫服，汗出愈。", "ingredient_text": "知母六兩甘草（炙）二兩石膏一斤粳米二合桂枝（去皮）三兩", "clauses": ["4.4"]}
{"name_zh": "蜀漆散", "herbal": true, "chapter": "瘧病脈證並治第四", "after_clause": "4.5", "ingredients": [{"name": "蜀漆", "dose_original": null, "prep": "洗去腥"}, {"name": "雲母", "dose_original": null, "prep": "燒二日夜"}, {"name": "龍骨", "dose_original": "等分", "prep": ""}], "preparation": "上三味，杵為散，未發前以漿水服半錢匕。溫瘧加蜀漆半分，臨發時服一錢匕。", "ingredient_text": "蜀漆（洗去腥）雲母（燒二日夜）龍骨等分", "clauses": ["4.5"]}
{"name_zh": "頭風摩散", "herbal": true, "chapter": "中風歷節病脈證並治第五", "after_clause": "5.3", "ingredients": [{"name": "大附子", "dose_original": "一枚", "prep": "炮"}, {"name": "鹽", "dose_original": "等分", "prep": ""}], "preparation": "上二味為散，沐了，以方寸匕，已摩疢上，令藥力行。", "ingredient_text": "大附子一枚（炮）鹽等分", "clauses": []}
{"name_zh": "桂枝芍藥知母湯", "herbal": true, "chapter": "中風歷節病脈證並治第五", "after_clause": "5.8", "ingredients": [{"name": "桂枝", "dose_original": "四兩", "prep": ""}, {"name": "芍藥", "dose_original": "三兩", "prep": ""}, {"name": "甘草", "dose_original": "二兩", "prep": ""}, {"name": "麻黃", "dose_original": "二兩", "prep": ""}, {"name": "生薑", "dose_original": "五兩", "prep": ""}, {"name": "白朮", "dose_original": "五兩", "prep": ""}, {"name": "知母", "dose_original": "四兩", "prep": ""}, {"name": "防風", "dose_original": "四兩", "prep": ""}, {"name": "附子", "dose_original": "二枚", "prep": "炮"}], "preparation": "上九味，以水七升，煮取二升，溫服七合，日三服。", "ingredient_text": "桂枝四兩芍藥三兩甘草二兩麻黃二兩生薑五兩白朮五兩知母四兩防風四兩附子二枚（炮）", "clauses": ["5.8"]}
{"name_zh": "黃耆桂枝五物湯", "herbal": true, "chapter": "血痹虛勞病脈證並治第六", "after_clause": "6.2", "ingredients": [{"name": "黃耆", "dose_original": "三兩", "prep": ""}, {"name": "芍藥", "dose_original": "三兩", "prep": ""}, {"name": "桂枝", "dose_original": "三兩", "prep": ""}, {"name": "生薑", "dose_original": "六兩", "prep": ""}, {"name": "大棗", "dose_original": "十二枚", "prep": ""}], "preparation": "上五味，以水六升，煮取二升，溫服七合，日三服，。", "ingredient_text": "黃耆三兩芍藥三兩桂枝三兩生薑六兩大棗十二枚", "clauses": ["6.2"]}
{"name_zh": "天雄散", "herbal": true, "chapter": "血痹虛勞病脈證並治第六", "after_clause": "6.8", "ingredients": [{"name": "天雄", "dose_original": "三兩", "prep": "炮"}, {"name": "白朮", "dose_original": "八兩", "prep": ""}, {"name": "桂枝", "dose_original": "六兩", "prep": ""}, {"name": "龍骨", "dose_original": "三兩", "prep": ""}], "preparation": "上四味、杵為散，酒服半錢匕，日三服，不知，稍增之。", "ingredient_text": "天雄三兩（炮）白朮八兩桂枝六兩龍骨三兩", "clauses": []}
{"name_zh": "小建中湯", "herbal": true, "chapter": "血痹虛勞病脈證並治第六", "after_clause": "6.13", "ingredients": [{"name": "桂枝", "dose_original": "三兩", "prep": "去皮"}, {"name": "甘草", "dose_original": "三兩", "prep": "炙"}, {"name": "大棗", "dose_original": "十二枚", "prep": ""}, {"name": "芍藥", "dose_original": "六兩", "prep": ""}, {"name": "生薑", "dose_original": "三兩", "prep": ""}, {"name": "膠飴", "dose_original": "一升", "prep": ""}], "preparation": "上六味，以水七升，煮取三升，去滓，內膠飴，更上微火消解，溫服一升，日三服。", "ingredient_text": "桂枝三兩（去皮）甘草三兩（炙）大棗十二枚芍藥六兩生薑三兩膠飴一升", "clauses": ["6.13", "22.19"]}
{"name_zh": "腎氣丸", "herbal": true, "chapter": "血痹虛勞病脈證並治第六", "after_clause": "6.15", "ingredients": [{"name": "乾地黃", "dose_original": "八兩", "prep": ""}, {"name": "山藥", "dose_original": "四兩", "prep": ""}, {"name": "山茱萸", "dose_original": "四兩", "prep": ""}, {"name": "澤瀉", "dose_original": "三兩", "prep": ""}, {"name": "牡丹皮", "dose_original": "三兩", "prep": ""}, {"name": "茯苓", "dose_original": "三兩", "prep": ""}, {"name": "桂枝", "dose_original": "一兩", "prep": ""}, {"name": "附子", "dose_original": "一兩", "prep": "炮"}], "preparation": "上八味末之，煉蜜和丸梧子大，酒下十五丸，加至二十五丸，日再服。", "ingredient_text": "乾地黃八兩山藥山茱萸各四兩澤瀉牡丹皮茯苓各三兩桂枝附子（炮）各一兩", "clauses": ["6.15", "12.18", "13.4", "22.20"]}
{"name_zh": "薯蕷丸", "herbal": true, "chapter": "血痹虛勞病脈證並治第六", "after_clause": "6.16", "ingredients": [{"name": "薯蕷", "dose_original": "三十分", "prep": ""}, {"name": "當歸", "dose_original": "十分", "prep": ""}, {"name": "桂枝", "dose_original": "十分", "prep": ""}, {"name": "条", "dose_original": "十分", "prep": ""}, {"name": "乾地黃", "dose_original": "十分", "prep": ""}, {"name": "豆黃卷", "dose_original": "十分", "prep": ""}, {"name": "甘草", "dose_original": "二十八分", "prep": ""}, {"name": "人參", "dose_original": "七分", "prep": ""}, {"name": "芎藭", "dose_original": "六分", "prep": ""}, {"name": "芍藥", "dose_original": "六分", "prep": ""}, {"name": "白朮", "dose_original": "六分", "prep": ""}, {"name": "麥門冬", "dose_original": "六分", "prep": ""}, {"name": "杏仁", "dose_original": "六分", "prep": ""}, {"name": "柴胡", "dose_original": "五分", "prep": ""}, {"name": "桔梗", "dose_original": "五分", "prep": ""}, {"name": "茯苓", "dose_original": "五分", "prep": ""}, {"name": "阿膠", "dose_original": "七分", "prep": ""}, {"name": "乾薑", "dose_original": "三分", "prep": ""}, {"name": "白斂", "dose_original": "二分", "prep": ""}, {"name": "防風", "dose_original": "六分", "prep": ""}, {"name": "大棗", "dose_original": "百枚", "prep": ""}, {"name": "為膏", "dose_original": null, "prep": ""}], "preparation": "上二十一味，末之，煉蜜和丸，如彈子大，空腹酒服一丸，一百丸為劑。", "ingredient_text": "薯蕷三十分當歸桂枝条乾地黃豆黃卷各十分甘草二十八分人參七分芎藭芍藥白朮麥門冬杏仁各六分柴胡桔梗茯苓各五分阿膠七分乾薑三分白斂二分防風六分大棗百枚為膏", "clauses": ["6.16"]}
{"name_zh": "酸棗仁湯", "herbal": true, "chapter": "血痹虛勞病脈證並治第六", "after_clause": "6.17", "ingredients": [{"name": "酸棗仁", "dose_original": "二升", "prep": ""}, {"name": "甘草", "dose_original": "一兩", "prep": ""}, {"name": "知母", "dose_original": "二兩", "prep": ""}, {"name": "茯苓", "dose_original": "二兩", "prep": ""}, {"name": "芎藭", "dose_original": "二兩", "prep": ""}, {"name": "深師有生薑", "dose_original": "二兩", "prep": ""}], "preparation": "上五味，以水八升，煮酸棗仁，得六升，內諸藥，煮取三升，分溫三服。", "ingredient_text": "酸棗仁二升甘草一兩知母二兩茯苓二兩芎藭二兩深師有生薑二兩", "clauses": ["6.17"]}
{"name_zh": "大黃䗪蟲丸", "herbal": true, "chapter": "血痹虛勞病脈證並治第六", "after_clause": "6.18", "ingredients": [{"name": "大黃", "dose_original": "十分", "prep": "蒸"}, {"name": "黃芩", "dose_original": "二兩", "prep": ""}, {"name": "甘草", "dose_original": "三兩", "prep": ""}, {"name": "桃仁", "dose_original": "一升", "prep": ""}, {"name": "杏仁", "dose_original": "一升", "prep": ""}, {"name": "芍藥", "dose_original": "四兩", "prep": ""}, {"name": "乾地黃", "dose_original": "十兩", "prep": ""}, {"name": "乾漆", "dose_original": "一兩", "prep": ""}, {"name": "虻蟲", "dose_original": "一升", "prep": ""}, {"name": "水蛭", "dose_original": "百枚", "prep": ""}, {"name": "蠐螬", "dose_original": "一升", "prep": ""}, {"name": "䗪蟲", "dose_original": "半升", "prep": ""}], "preparation": "上十二味，末之，煉蜜和丸小豆大，酒飲服五丸，日三服。", "ingredient_text": "大黃十分（蒸）黃芩二兩甘草三兩桃仁一升杏仁一升芍藥四兩乾地黃十兩乾漆一兩虻蟲一升水蛭百枚蠐螬一升䗪蟲半升", "clauses": ["6.18"]}
{"name_zh": "小青龍加石膏湯", "herbal": true, "chapter": "肺痿肺癰咳嗽上氣病脈證並治第七", "after_clause": "7.15", "ingredients": [{"name": "麻黃", "dose_original": "三兩", "prep": ""}, {"name": "芍藥", "dose_original": "三兩", "prep": ""}, {"name": "桂枝", "dose_original": "三兩", "prep": ""}, {"name": "細辛", "dose_original": "三兩", "prep": ""}, {"name": "甘草", "dose_original": "三兩", "prep": ""}, {"name": "乾姜", "dose_original": "三兩", "prep": ""}, {"name": "五味子", "dose_original": "半升", "prep": ""}, {"name": "半夏", "dose_original": "半升", "prep": ""}, {"name": "石膏", "dose_original": "二兩", "prep": ""}], "preparation": "右九味，以水一斗，先煮麻黃，去上沫，內諸藥，煮取三升。強人服一升，羸者減之，日三服，小兒服四合。", "ingredient_text": "麻黃、芍藥、桂枝、細辛、甘草、乾姜各三兩，五味子、半夏各半升，石膏二兩。", "clauses": ["7.15"]}
{"name_zh": "奔豚湯", "herbal": true, "chapter": "奔豚氣病脈證並治第八", "after_clause": "8.2", "ingredients": [{"name": "甘草", "dose_original": "二兩", "prep": ""}, {"name": "芎藭", "dose_original": "二兩", "prep": ""}, {"name": "當歸", "dose_original": "二兩", "prep": ""}, {"name": "半夏", "dose_original": "四兩", "prep": ""}, {"name": "黃芩", "dose_original": "二兩", "prep": ""}, {"name": "生葛", "dose_original": "五兩", "prep": ""}, {"name": "芍藥", "dose_original": "二兩", "prep": ""}, {"name": "生薑", "dose_original": "四兩", "prep": ""}, {"name": "甘李根白皮", "dose_original": "一升", "prep": ""}], "preparation": "上九味，以水二斗，煮取五升，溫服一升，日三夜一服。", "ingredient_text": "甘草芎藭當歸各二兩半夏四兩黃芩二兩生葛五兩芍藥二兩生薑四兩甘李根白皮一升。", "clauses": ["8.2"]}
{"name_zh": "桂枝加桂湯", "herbal": true, "chapter": "奔豚氣病脈證並治第八", "after_clause": "8.3", "ingredients": [{"name": "桂枝", "dose_original": "五兩", "prep": ""}, {"name": "芍藥", "dose_original": "三兩", "prep": ""}, {"name": "甘草", "dose_original": "二兩", "prep": "炙"}, {"name": "生薑", "dose_original": "三兩", "prep": ""}, {"name": "大棗", "dose_original": "十二枚", "prep": ""}], "preparation": "上五味，以水七升，微火煮取三升，去滓，溫服一升。", "ingredient_text": "桂枝五兩芍藥三兩甘草二兩（炙）生薑三兩大棗十二枚", "clauses": ["8.3"]}
{"name_zh": "茯苓桂枝甘草大棗湯", "herbal": true, "chapter": "奔豚氣病脈證並治第八", "after_clause": "8.4", "ingredients": [{"name": "茯苓", "dose_original": "半斤", "prep": ""}, {"name": "甘草", "dose_original": "二兩", "prep": "炙"}, {"name": "大棗", "dose_original": "十五枚", "prep": ""}, {"name": "桂枝", "dose_original": "四兩", "prep": ""}], "preparation": "上四味，以甘瀾水一斗，先煮茯苓、減二升，內諸藥，煮取三升，去滓，溫服一升，日三服。", "ingredient_text": "茯苓半斤甘草二兩（炙）大棗十五枚桂枝四兩", "clauses": ["8.4"]}
{"name_zh": "赤石脂丸", "herbal": true, "chapter": "胸痹心痛短氣病脈證並治第九", "after_clause": "9.9", "ingredients": [{"name": "蜀椒", "dose_original": "一兩", "prep": "一法二分"}, {"name": "烏頭", "dose_original": "一分", "prep": "炮"}, {"name": "附子", "dose_original": "半兩", "prep": "炮；一法一分"}, {"name": "乾姜", "dose_original": "一兩", "prep": "一法一分"}, {"name": "赤石脂", "dose_original": "一兩", "prep": "一法二分"}], "preparation": "右五味，末之，蜜丸如梧子大，先食服一丸，日三服。", "ingredient_text": "蜀椒一兩，一法二分；烏頭一分，炮；附子半兩，炮，一法一分；乾姜一兩，一法一分；赤石脂一兩，一法二分。", "clauses": ["9.9"]}
{"name_zh": "豬苓湯", "herbal": true, "chapter": "消渴小便不利淋病脈證並治第十三", "after_clause": "13.14", "ingredients": [{"name": "豬苓", "dose_original": "一兩", "prep": "去皮"}, {"name": "茯苓", "dose_original": "一兩", "prep": ""}, {"name": "阿膠", "dose_original": "一兩", "prep": ""}, {"name": "滑石", "dose_original": "一兩", "prep": ""}, {"name": "澤瀉", "dose_original": "一兩", "prep": ""}], "preparation": "右五味，以水四升，先煮四味，取二升，去滓，內膠洋消，溫服七合，日三服。", "ingredient_text": "豬苓，去皮；茯苓；阿膠；滑石；澤瀉各一兩。", "clauses": ["1.20", "13.14"]}
{"name_zh": "枳朮湯", "herbal": true, "chapter": "水氣病脈證並治第十四", "after_clause": "14.38", "ingredients": [{"name": "枳實", "dose_original": "七枚", "prep": ""}, {"name": "白朮", "dose_original": "二兩", "prep": ""}], "preparation": "右二味，以水五升，煮取三升，分溫三服，腹中耎，即當。", "ingredient_text": "枳實七枚，白朮二兩。", "clauses": ["14.38"]}
{"name_zh": "訶梨勒散", "herbal": true, "chapter": "嘔吐噦下利病脈證並治第十七", "after_clause": "17.49", "ingredients": [{"name": "訶梨勒", "dose_original": "十枚", "prep": ""}], "preparation": "右一味，為散，粥飲和，頓服。", "ingredient_text": "訶梨勒十枚。", "clauses": []}
{"name_zh": "薏苡附子敗醬散", "herbal": true, "chapter": "瘡癰腸癰浸淫病脈證並治第十八", "after_clause": "18.3", "ingredients": [{"name": "薏苡仁", "dose_original": "十分", "prep": ""}, {"name": "附子", "dose_original": "二分", "prep": ""}, {"name": "敗醬", "dose_original": "五分", "prep": ""}], "preparation": "右三味，杵為末，取方寸匕，以水二升，煎減半，頓服，小便當下。", "ingredient_text": "薏苡仁十分，附子二分，敗醬五分。", "clauses": ["18.3"]}
{"name_zh": "大黃牡丹湯", "herbal": true, "chapter": "瘡癰腸癰浸淫病脈證並治第十八", "after_clause": "18.4", "ingredients": [{"name": "大黃", "dose_original": "四兩", "prep": ""}, {"name": "牡丹", "dose_original": "一兩", "prep": ""}, {"name": "桃仁", "dose_original": "五十箇", "prep": ""}, {"name": "瓜子", "dose_original": "半升", "prep": ""}, {"name": "芒消", "dose_original": "三合", "prep": ""}], "preparation": "右五味，以水六升，煮取一升，去滓，內芒消再煎沸，頓服之，有膿當下，如先膿，當下血。", "ingredient_text": "大黃四兩，牡丹一兩，桃仁五十箇，瓜子半升，芒消三合。", "clauses": ["18.4"]}
{"name_zh": "排膿散", "herbal": true, "chapter": "瘡癰腸癰浸淫病脈證並治第十八", "after_clause": "18.9", "ingredients": [{"name": "枳實", "dose_original": "十六枚", "prep": ""}, {"name": "芍藥", "dose_original": "六分", "prep": ""}, {"name": "桔梗", "dose_original": "一分", "prep": ""}], "preparation": "右三味，杵為散，取雞子黃一枚，以藥散與雞黃相等，揉和。", "ingredient_text": "枳實十六枚，芍藥六分，桔梗一分。", "clauses": []}
{"name_zh": "蜘蛛散", "herbal": true, "chapter": "跗蹶手指臂腫轉筋陰狐疝蚘蟲病脈證並治第十九", "after_clause": "19.4", "ingredients": [{"name": "蜘蛛", "dose_original": "十四枚", "prep": "熬焦"}, {"name": "桂枝", "dose_original": "半兩", "prep": ""}], "preparation": "右二味，為散，取八分一匕，飲和服，日再服，蜜丸亦可。", "ingredient_text": "蜘蛛十四枚，熬焦；桂枝半兩。", "clauses": ["19.4"]}
{"name_zh": "甘草粉蜜湯", "herbal": true, "chapter": "跗蹶手指臂腫轉筋陰狐疝蚘蟲病脈證並治第十九", "after_clause": "19.6", "ingredients": [{"name": "甘草", "dose_original": "二兩", "prep": ""}, {"name": "粉", "dose_original": "一兩", "prep": ""}, {"name": "重", "dose_original": null, "prep": ""}, {"name": "蜜", "dose_original": "四兩", "prep": ""}], "preparation": "右三味，以水三升，先煮甘草，取二升，去滓，內粉蜜，攪令和，煎如薄粥，溫服一升，差即止。", "ingredient_text": "甘草二兩，粉一兩重，蜜四兩。", "clauses": ["19.6"]}
{"name_zh": "鳥梅丸", "herbal": true, "chapter": "跗蹶手指臂腫轉筋陰狐疝蚘蟲病脈證並治第十九", "after_clause": "19.8", "ingredients": [{"name": "烏梅", "dose_original": "三百箇", "prep": ""}, {"name": "細辛", "dose_original": "六兩", "prep": ""}, {"name": "乾姜", "dose_original": "十兩", "prep": ""}, {"name": "黃連", "dose_original": "一斤", "prep": ""}, {"name": "當歸", "dose_original": "四兩", "prep": ""}, {"name": "附子", "dose_original": "六兩", "prep": "炮"}, {"name": "川椒", "dose_original": "四兩", "prep": "去汁"}, {"name": "桂枝", "dose_original": "六兩", "prep": ""}, {"name": "人參", "dose_original": "六兩", "prep": ""}, {"name": "黃蘗", "dose_original": "六兩", "prep": ""}], "preparation": "右十味，異搗篩，合治之，以苦酒漬烏梅一宿，去核，蒸之五升米下，飯熟擣成泥，和藥令相得，內臼中，與蜜杵五千下，丸如梧子大，先食飲服十丸。三服，稍加至二十丸。禁生冷潰臭等食。", "ingredient_text": "烏梅三百箇；細辛六兩；乾姜十兩；黃連一斤；當歸四兩；附子六兩，炮；川椒四兩，去汁；桂枝六兩；人參、黃蘗各六兩。", "clauses": []}
{"name_zh": "桂枝茯苓丸", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.2", "ingredients": [{"name": "桂枝", "dose_original": "等分", "prep": ""}, {"name": "茯苓", "dose_original": "等分", "prep": ""}, {"name": "牡丹去心", "dose_original": "等分", "prep": ""}, {"name": "桃仁去皮", "dose_original": "等分", "prep": ""}, {"name": "尖", "dose_original": "等分", "prep": "熬"}, {"name": "芍藥", "dose_original": "等分", "prep": ""}], "preparation": "右五味，末之，煉蜜和丸如兔屎大，每日食前服一丸，不知，加至三丸。", "ingredient_text": "桂枝；茯苓；牡丹去心；桃仁去皮、尖，熬；芍藥各等分。", "clauses": ["21.2"]}
{"name_zh": "芎歸膠艾湯", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.4", "ingredients": [{"name": "芎窮", "dose_original": "二兩", "prep": ""}, {"name": "阿膠", "dose_original": "二兩", "prep": ""}, {"name": "甘草", "dose_original": "二兩", "prep": ""}, {"name": "艾葉", "dose_original": "三兩", "prep": ""}, {"name": "當歸", "dose_original": "三兩", "prep": ""}, {"name": "芍藥", "dose_original": "四兩", "prep": ""}, {"name": "乾地黃", "dose_original": null, "prep": ""}], "preparation": "右七味，以水五升，清酒五升，合煮取三升，去滓，內膠令消盡，溫服一升，日三服，不差更作。", "ingredient_text": "芎窮、阿膠、甘草各二兩，艾葉、當歸各三兩，芍藥四兩，乾地黃。", "clauses": []}
{"name_zh": "當歸芍藥散", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.5", "ingredients": [{"name": "當歸", "dose_original": "三兩", "prep": ""}, {"name": "芍藥", "dose_original": "一斤", "prep": ""}, {"name": "茯苓", "dose_original": "四兩", "prep": ""}, {"name": "白朮", "dose_original": "四兩", "prep": ""}, {"name": "澤瀉", "dose_original": "半斤", "prep": ""}, {"name": "芎藭", "dose_original": "半斤", "prep": ""}], "preparation": "右六味，杵為散，取方寸匕，酒和，日三服。", "ingredient_text": "當歸三兩，芍藥一斤，茯苓四兩，白朮四兩，澤瀉半斤，芎藭半斤。", "clauses": ["21.5", "22.18"]}
{"name_zh": "乾姜人參半夏丸", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.6", "ingredients": [{"name": "乾姜", "dose_original": "一兩", "prep": ""}, {"name": "人參", "dose_original": "一兩", "prep": ""}, {"name": "半夏", "dose_original": "二兩", "prep": ""}], "preparation": "右三味，末之，以生姜汁糊為丸如梧子大，飲服十丸，日三服。", "ingredient_text": "乾姜、人參各一兩，半夏二兩。", "clauses": ["21.6"]}
{"name_zh": "當歸貝母苦參丸", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.7", "ingredients": [{"name": "當歸", "dose_original": "四兩", "prep": ""}, {"name": "貝母", "dose_original": "四兩", "prep": ""}, {"name": "苦參", "dose_original": "四兩", "prep": ""}], "preparation": "右三味，末之，煉蜜丸如小豆大，飲服三丸，加至十丸。", "ingredient_text": "當歸、貝母、苦參各四兩。", "clauses": ["21.7"]}
{"name_zh": "葵子茯苓散", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.8", "ingredients": [{"name": "葵子", "dose_original": null, "prep": ""}, {"name": "茯苓", "dose_original": "三兩", "prep": ""}], "preparation": "右二味，杵為散，飲服方寸匕，日三服，小便利則愈。", "ingredient_text": "葵子，茯苓三兩。", "clauses": ["21.8"]}
{"name_zh": "當歸散", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.9", "ingredients": [{"name": "當歸", "dose_original": "一兩", "prep": ""}, {"name": "黃芩", "dose_original": "一兩", "prep": ""}, {"name": "芍藥", "dose_original": "一兩", "prep": ""}, {"name": "芎藭", "dose_original": "一兩", "prep": ""}, {"name": "白朮", "dose_original": "半斤", "prep": ""}], "preparation": "右五味，杵為散，酒飲服方寸匕，日再服。妊娠常服即易產，胎無苦疾，產後百病悉主之。", "ingredient_text": "當歸、黃芩、芍藥、芎藭各一兩，白朮半斤。", "clauses": ["16.16", "21.9"]}
{"name_zh": "白朮散", "herbal": true, "chapter": "婦人妊娠病脈證並治第二十", "after_clause": "21.10", "ingredients": [{"name": "白朮", "dose_original": null, "prep": ""}, {"name": "芎窮", "dose_original": null, "prep": ""}, {"name": "蜀椒", "dose_original": "三分", "prep": ""}, {"name": "汁", "dose_original": null, "prep": ""}, {"name": "牡蠣", "dose_original": null, "prep": ""}], "preparation": "右四味，杵為散，酒服一錢匕，日三服，夜一服。但苦痛，加芍藥；心下毒痛，倍加芎藭；心煩吐痛，不能食飲，加細辛一兩、半夏大者二十枚，服之後，更以醋漿水服之；若嘔，以醋漿水服之，後不解者，小麥汁服之；已後渴者，大麥粥服之。病雖愈，服之勿置。", "ingredient_text": "白朮；芎窮；蜀椒三分，汁；牡蠣。", "clauses": ["21.10"]}
